* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: #0b1020;
  color: #eef2ff;
  min-height: 100vh;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  background:
    radial-gradient(
      circle at 15% 10%,
      #263d70 0,
      transparent 35%
    ),
    radial-gradient(
      circle at 90% 20%,
      #47205d 0,
      transparent 30%
    );
  pointer-events: none;
  z-index: -1;
}


/* TOP BAR */

.topbar {
  padding: 35px 5%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.topbar h1 {
  margin: 8px 0;
  font-size: clamp(30px, 5vw, 48px);
}

.topbar p {
  color: #aab7d6;
}

.eyebrow {
  color: #8ea5d9;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.15em;
}

.system-status {
  background: #123c34;
  color: #67f0c0;
  padding: 10px 15px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 800;
}


/* MAIN */

main {
  width: 90%;
  max-width: 1200px;
  margin: auto;
}


/* CARDS */

.card {
  background: rgba(17, 25, 47, 0.88);
  border: 1px solid rgba(142, 165, 217, 0.16);
  border-radius: 22px;
  padding: 22px;
  margin-bottom: 18px;
  box-shadow:
    0 18px 50px rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(12px);
}


/* ACCOUNT CONTROL */

.account-control {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.account-control h2 {
  margin: 7px 0;
}

.account-control p {
  color: #aab7d6;
}

select {
  background: #6c63ff;
  color: white;
  border: none;
  border-radius: 12px;
  padding: 13px 18px;
  font-weight: 800;
  cursor: pointer;
}


/* STATISTICS */

.stats-grid {
  display: grid;
  grid-template-columns:
    repeat(4, 1fr);
  gap: 18px;
}

.stat-card span {
  color: #9eaccb;
}

